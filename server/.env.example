# Reference only; this file is not loaded automatically.
ASPNETCORE_URLS="<loopback-http-url>"
ASPNETCORE_ENVIRONMENT="<Development-or-Production>"
# Authored mode needs no provider settings. Keep false for model-free local use.
Explanations__LiveEnabled=false

# Azure OpenAI connection (shared by the offside explainer and the match narrator).
# Explanations__AzureOpenAi__Endpoint=https://YOUR-RESOURCE-NAME.openai.azure.com/
# Explanations__AzureOpenAi__DeploymentName=<approved-deployment>
# Keyless Microsoft Entra authentication is preferred; no key exists anywhere:
#   ManagedIdentity  - in Azure Container Apps; optionally name a user-assigned identity
#   AzureCli         - locally, using your `az login` session (needs the "Cognitive Services OpenAI User" role)
# Explanations__AzureOpenAi__AuthMode=ManagedIdentity
# Explanations__AzureOpenAi__ManagedIdentityClientId=<client-id-of-the-user-assigned-identity>
# Explanations__AzureOpenAi__TokenScope=https://ai.azure.com/.default
# Key mode (the default when AuthMode is omitted) only after separate access/spending approval:
# Explanations__AzureOpenAi__ApiKey=<server-only-secret>

# AI narration in English and Tamil with an operator approval gate. Off by default: the app then serves
# the deterministic English text and never calls a model.
# Narration__Enabled=true
# Narration__MaxModelCalls=160          # model calls this process may start in its lifetime
# Narration__MaxConcurrency=2
# Narration__ReasoningEffort=low        # none, low, medium, high or xhigh; empty sends nothing (the model default)
# Narration__MaxCompletionTokens=2048
# Gate__SlaSeconds=20                   # operator decision window, also the program delay
# Gate__MaxSessions=16

# Application Insights export (OpenTelemetry). Nothing is exported unless this is set.
# APPLICATIONINSIGHTS_CONNECTION_STRING=<from the Application Insights resource>
