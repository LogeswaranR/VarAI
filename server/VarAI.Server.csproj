<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Contracts/**/*.cs" />
    <Content Remove="Contracts/**" />
    <None Remove="Contracts/**" />
    <Content Include="../client/dist/**/*" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Contracts\VarAI.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.6.9" />
  </ItemGroup>

  <Target Name="RequireClientBuildForPublish" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../client/dist/index.html')" Text="Build the client first with 'npm run build:client', or use 'npm run publish' from the repository root." />
  </Target>

</Project>
